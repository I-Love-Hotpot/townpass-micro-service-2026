+            'language': '繁體中文',
+            'source': source,
+            'logicNotes': draft['d'] ?? [],
+            'e': evidence.values.indexed.map((row) => {'i': row.$1, 'name': row.$2['title'], 'article': row.$2['unit_label'], 'text': row.$2['context_text'] ?? row.$2['text'], 'excerpt': row.$2['context_is_excerpt'] == true}).toList(),
+          })}',
+        );
+        stages['answerRaw'] = answerRaw;
+        stages['firstBatchSeconds'] =
+            stages['ocrSeconds'] + stages['planSeconds'];
+        stages['answersSeconds'] =
+            (watch.elapsedMilliseconds - answerStarted) / 1000;
+        stages['answerMetrics'] = jsonDecode(
+          (await const MethodChannel('townpass/govclear_local')
+              .invokeMethod<String>('metrics'))!,
+        );
+        stages['totalSeconds'] = watch.elapsedMilliseconds / 1000;
+        stages['under20Seconds'] = watch.elapsedMilliseconds <= 20000;
+        await file.writeAsString(jsonEncode(report));
+        final answer = modelJson(answerRaw);
+        expect((answer['a'] as List).length, lessThanOrEqualTo(3));
+        expect(
+          answer['a'],
+          isNotEmpty,
+        ); // This synthetic notice has actionable questions.
+        for (final row in answer['a']) {
+          expect(row['q'], isA<String>());
+          expect(row['t'], isA<String>());
+          expect(
+            (row['c'] as List).every((ref) {
+              final match = ref is String
+                  ? RegExp(r'^(?:e\[(\d+)\]|(\d+))$').firstMatch(ref)
+                  : null;
+              final index = ref is int
+                  ? ref
+                  : match != null
+                  ? int.parse(match[1] ?? match[2]!)
+                  : evidence.keys.toList().indexOf(ref);
+              return index >= 0 && index < evidence.length;
+            }),
+            isTrue,
+          );
+        }
+        stages['answers'] = answer['a'];
+        stages['sourceCharacters'] = source.length;
+        stages['evidenceCount'] = evidence.length;
+        expect(
+          evidence.length,
+          3,
+        ); // All three reference candidates stay available.
+        (report['runs'] as List).add(stages);
+        await file.writeAsString(jsonEncode(report));
+        expect(stages['totalSeconds'], lessThanOrEqualTo(20));
+      }
+      report['logicCases'] = <dynamic>[];
+      for (final input in [
+        ('交通通知記載：14歲駕駛超速。', true),
+        ('乘客14歲，駕駛人為45歲的父親。車輛因超速收到通知。', false),
