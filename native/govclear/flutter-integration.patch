+      ]).any((u) => u['law_id'] == 'pip_b1020_faq_115'),
+      isTrue,
+    );
+    expect(GovClearKnowledge.search(units, []), isEmpty);
+    expect(() => GovClearKnowledge.search(units, ['a']), returnsNormally);
+    expect(
+      GovClearKnowledge.search(
+        [
+          {'text': '測試', 'abolished': true},
+        ],
+        ['測試'],
+      ),
+      isEmpty,
+    );
+  });
+  test('focused context keeps complete clauses, linked exceptions and original text', () {
+    const text =
+        '申請應符合下列規定：\n一、住宅用途應合法。\n（一）主要用途為住宅。\n（二）空白者按住家稅率。但另有證明者不在此限。\n二、租賃契約承租人應為申請人。\n未保存登記者，不受前項第一款規定之限制。';
+    final context = GovClearKnowledge.contextText(text, '住宅用途');
+    expect(context, contains('（一）主要用途為住宅。\n（二）空白者按住家稅率。但另有證明者不在此限。'));
+    expect(context, contains('不受前項第一款規定之限制'));
+    expect(context, isNot(contains('二、租賃契約')));
+    expect(text, contains('二、租賃契約'));
+  });
+  test('FAQ excerpts retain wrapped continuation lines and a complete selected answer', () {
+    const text =
+        '如何辦理？\n（一）租約到期請先確認資格。\n（二）線上補件方式如下：\n前往網站\nhttps://example.org\n點選補件並上傳。\n（三）其他申請方式。';
+    final context = GovClearKnowledge.contextText(text, '線上補件');
+    expect(
+      context,
+      '如何辦理？\n（一）租約到期請先確認資格。\n（二）線上補件方式如下：\n前往網站\nhttps://example.org\n點選補件並上傳。',
+    );
+    expect(GovClearKnowledge.contextText(text, '完全無關'), text);
+    expect(GovClearKnowledge.contextText(text, ''), text);
+  });
+  test('all three references retain full text alongside shorter per-reference context', () {
+    final units = GovClearKnowledge.decode(
+      File('assets/govclear_rag/knowledge.json').readAsBytesSync(),
+    );
+    final found = GovClearKnowledge.search(units, ['提出租金補貼申請', '附上身分證及租賃契約']);
+    expect(found.length, 3);
+    var original = 0, focused = 0;
+    for (final unit in found) {
+      final text = unit['text'] as String;
+      final context = GovClearKnowledge.contextText(
+        text,
+        '租金補貼通知，請在115年12月10日前提出申請，附上身分證及租賃契約，符合資格才可領取補貼。',
+      );
+      expect(context, isNotEmpty);
+      expect(unit['text'], text);
+      original += text.length;
+      focused += context.length;
+    }
+    expect(focused, lessThan(original));
+  });
+  test(
+    'FAQ base conditions are retained alongside later supplement instructions',
+    () {
+      final units = GovClearKnowledge.decode(
+        File('assets/govclear_rag/knowledge.json').readAsBytesSync(),
+      );
+      final unit = units.firstWhere(
+        (u) => u['unit_id'] == 'pip_b1020_faq_115:q35:bba4aa037cbb25507d05',
+      );
+      final context = GovClearKnowledge.contextText(
+        unit['text'] as String,
+        '租金補貼申請，附上身分證及租賃契約。',
+      );
+      expect(context, contains('仍可繼續辦理審核'));
+      expect(context, contains('無法撥款'));
+      expect(context, contains('補新租約'));
+    },
+  );
+}
