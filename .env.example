# Backend
ALLOWED_ORIGINS=*

# PR preview menu: GitHub fine-grained token with Pull requests read-only access.
# Set in the local .env or Coolify; never use a VITE_ prefix or commit the token.
GITHUB_TOKEN=

# Database
# Docker Compose overrides DB_HOST and DB_PORT for the backend container.
MYSQL_DATABASE=townpass
MYSQL_USER=townpassuser
MYSQL_PASSWORD=townpasspassword
MYSQL_ROOT_PASSWORD=rootpassword

# Frontend
# Public backend used by the browser. For local Docker development, use
# http://localhost:3001. An empty value uses the production same-origin proxy.
VITE_API_BASE_URL=https://api.tp.dstw.dev
APP_BASE_URL=https://tp.dstw.dev
