+      ..addText(
+        '租金補貼通知\n115年度租金補貼開放申請。\n請在115年12月10日前提出申請。\n申請時請附上身分證及租賃契約。\n符合資格者才可領取補貼。',
+      );
+    final paragraph = builder.build()
+      ..layout(const ui.ParagraphConstraints(width: 900));
+    canvas.drawParagraph(paragraph, const ui.Offset(40, 50));
+    final picture = recorder.endRecording();
+    final image = await picture.toImage(1000, 700);
+    final bytes = (await image.toByteData(format: ui.ImageByteFormat.png))!
+        .buffer
+        .asUint8List();
+    image.dispose();
+    picture.dispose();
+    final engine = SimulatorGemmaEngine();
+    try {
+      for (final state in ['cold', 'warm']) {
+        final watch = Stopwatch()..start();
+        final stages = <String, dynamic>{'state': state};
+        report['currentRun'] = stages;
+        final source = '【第 1 張】\n${await engine.transcribe(bytes)}';
+        stages['ocrSeconds'] = watch.elapsedMilliseconds / 1000;
+        final draft = modelJson(
+          await engine.generate(
+            '${policies['planPolicy']}${jsonEncode({'language': '繁體中文', 'source': source})}',
+          ),
+        );
+        stages['planSeconds'] =
+            watch.elapsedMilliseconds / 1000 - stages['ocrSeconds'];
+        stages['planMetrics'] = jsonDecode(
