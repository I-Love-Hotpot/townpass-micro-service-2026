+  /// Counts text with this model's tokenizer without running generation.
+  public func countTokens(_ text: String) throws -> Int {
+    guard let handle else { throw LiteRTLMError.engine(.notInitialized) }
+    let makeError: (String) -> LiteRTLMError = { .conversation(.invalidResponse($0)) }
+    let tokens = try LiteRTLMError.create("litert_lm_engine_tokenize", makeError) { out in
+      litert_lm_engine_tokenize(handle, text, out)
+    }
+    defer { litert_lm_tokenize_result_delete(tokens) }
+    return try LiteRTLMError.get(0, "litert_lm_tokenize_result_get_num_tokens", makeError) {
+      litert_lm_tokenize_result_get_num_tokens(tokens, $0)
+    }
+  }
