+        );
+        expect(draft['s'], isA<String>());
+        stages['sixFieldsReturned'] = (draft['w'] as Map).length;
+        stages['sourceCharacters'] = source.length;
+        expect(source, contains('租金'));
+        expect((draft['w'] as Map).length, 6);
+        stages['draft'] = draft;
+        stages['retrievalMode'] = 'document-facts';
+        final retrievalStarted = watch.elapsedMilliseconds;
+        final evidence = <String, Map<String, dynamic>>{};
+        final retrieval = jsonDecode(
+          await GovClearKnowledge.retrieve(
+            jsonEncode(
+              [
+                draft['w']['what'],
+                draft['w']['how'],
+              ].whereType<String>().toList(),
+            ),
+            source: source,
+          ),
+        );
+        for (final row in (retrieval['evidence'] as List).take(3)) {
+          evidence[row['unit_id']] = Map<String, dynamic>.from(row);
+        }
+        stages['evidenceUnits'] = evidence.values
+            .map(
+              (row) => {
+                'unit_id': row['unit_id'],
+                'unit_label': row['unit_label'],
+                'fullCharacters': (row['text'] as String).length,
+                'contextCharacters': (row['context_text'] as String).length,
+              },
+            )
+            .toList();
+        stages['retrievalSeconds'] =
+            (watch.elapsedMilliseconds - retrievalStarted) / 1000;
+        final answerStarted = watch.elapsedMilliseconds;
+        final answerRaw = await engine.generate(
