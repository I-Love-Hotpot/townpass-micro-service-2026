diff --git a/lib/service/govclear_knowledge.dart b/lib/service/govclear_knowledge.dart
new file mode 100644
--- /dev/null
+++ b/lib/service/govclear_knowledge.dart
@@ -0,0 +1,83 @@
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter/foundation.dart';
+
+/// The source bundle remains unchanged; this projection preserves every metadata field.
+class GovClearKnowledge {
+  static const checksum =
+      'a0f787503597e109b07ffb17544368b509b7c95fffed1e9c7d14268ac40d46a6';
+  static Future<List<Map<String, dynamic>>>? _loaded;
+
+  static Future<List<Map<String, dynamic>>> _load() async {
+    final bytes = await rootBundle.load('assets/govclear_rag/knowledge.json');
+    final data = bytes.buffer.asUint8List(
+      bytes.offsetInBytes,
+      bytes.lengthInBytes,
+    );
+    return compute(decode, data);
+  }
+
+  static List<Map<String, dynamic>> decode(Uint8List data) {
+    if (sha256.convert(data).toString() != checksum) {
+      throw StateError('知識庫版本驗證失敗，請重新安裝 App。');
+    }
+    final value = jsonDecode(utf8.decode(data)) as Map<String, dynamic>;
+    return (value['units'] as List).cast<Map<String, dynamic>>();
+  }
+
+  static List<Map<String, dynamic>> search(
+    List<Map<String, dynamic>> units,
+    List<String> terms,
+  ) {
+    if (terms.isEmpty ||
+        terms.length > 6 ||
+        terms.any((t) => t.trim().length < 2 || t.runes.length > 40)) {
+      throw StateError('檢索關鍵字不完整。');
+    }
+    final words = terms.map((t) => t.trim().toLowerCase()).toSet();
+    final scored = <({Map<String, dynamic> unit, int score})>[];
+    for (final unit in units) {
+      final text = unit['text'];
+      if (text is! String ||
+          text.trim().isEmpty ||
+          text.trim() == '（刪除）' ||
+          unit['abolished'] == true) {
+        continue;
+      }
+      final haystack = '${unit['title']} $text'.toLowerCase();
+      final score = words.where(haystack.contains).length;
+      if (score > 0) scored.add((unit: unit, score: score));
+    }
+    scored.sort((a, b) {
+      final order = b.score.compareTo(a.score);
+      return order != 0
+          ? order
+          : (a.unit['unit_id'] as String).compareTo(
+              b.unit['unit_id'] as String,
+            );
+    });
+    // shortcut: lexical recall only; add measured FTS ranking if this small corpus grows.
+    return scored.take(3).map((row) => row.unit).toList();
+  }
+
+  static Future<String> retrieve(String encodedTerms) async {
+    if (encodedTerms.length > 1000) throw StateError('檢索條件過長。');
+    final input = jsonDecode(encodedTerms);
+    if (input is! List || input.any((x) => x is! String)) {
+      throw StateError('無效檢索條件。');
+    }
+    final units = await (_loaded ??= _load().catchError((Object e) {
+      _loaded = null;
+      throw e;
+    }));
+    return jsonEncode({
+      'datasetVersion': 'CityBridgeFlutterEngine_v0_1_0',
+      'datasetHash': checksum,
+      'retrievedAt': DateTime.now().toUtc().toIso8601String(),
+      'historicalApplicability': 'unverified',
+      'evidence': search(units, input.cast<String>()),
+    });
+  }
+}
diff --git a/test/govclear_knowledge_test.dart b/test/govclear_knowledge_test.dart
new file mode 100644
--- /dev/null
+++ b/test/govclear_knowledge_test.dart
@@ -0,0 +1,44 @@
+import 'dart:typed_data';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:town_pass/service/govclear_knowledge.dart';
+
+void main() {
+  test('bundled data checksum, complete metadata and literal recall', () {
+    final data = File('assets/govclear_rag/knowledge.json').readAsBytesSync();
+    expect(sha256.convert(data).toString(), GovClearKnowledge.checksum);
+    final units = (jsonDecode(utf8.decode(data))['units'] as List)
+        .cast<Map<String, dynamic>>();
+    expect(units.length, 1135);
+    expect(GovClearKnowledge.decode(data).length, 1135);
+    final altered = data.toList()..[0] = 0;
+    expect(
+      () => GovClearKnowledge.decode(Uint8List.fromList(altered)),
+      throwsStateError,
+    );
+    final found = GovClearKnowledge.search(units, ['駕車行駛人行道']);
+    expect(
+      found.any(
+        (u) => u['law_id'] == 'k0040012' && u['unit_label'].contains('45'),
+      ),
+      isTrue,
+    );
+    expect(found.first['text'], contains('六、駕車行駛人行道。'));
+    expect(found.first.containsKey('provenance'), isTrue);
+    expect(GovClearKnowledge.search(units, ['完全無此關鍵字xyz']), isEmpty);
+    expect(() => GovClearKnowledge.search(units, []), throwsStateError);
+    expect(() => GovClearKnowledge.search(units, ['a']), throwsStateError);
+    expect(
+      GovClearKnowledge.search(
+        [
+          {'text': '測試', 'abolished': true},
+        ],
+        ['測試'],
+      ),
+      isEmpty,
+    );
+  });
+}
