{
  "name": "townpass-baihua",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint src --ext .vue,.ts",
    "format": "prettier --write src/",
    "dev:govclear": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:local": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-router": "4.3.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "1.8.0",
    "@tsconfig/node20": "20.1.4",
    "@types/node": "20.12.5",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/eslint-config-typescript": "13.0.0",
    "@vue/tsconfig": "0.5.1",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-plugin-prettier-vue": "5.0.0",
    "eslint-plugin-vue": "9.23.0",
    "fake-indexeddb": "^6.2.5",
    "npm-run-all2": "6.1.2",
    "postcss": "8.4.38",
    "prettier": "3.2.5",
    "tailwindcss": "3.4.4",
    "typescript": "~5.4.0",
    "vite": "5.2.8",
    "vue-tsc": "2.2.12"
  }
}
