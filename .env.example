# Backend
ALLOWED_ORIGINS=*

# Database
# Docker Compose overrides DB_HOST and DB_PORT for the backend container.
MYSQL_DATABASE=dev-townpass
MYSQL_USER=townpassuser
MYSQL_PASSWORD=townpasspassword
MYSQL_ROOT_PASSWORD=rootpassword

# Frontend
# Public backend used by the browser. Set this to an empty value to use the
# local Vite proxy or the production Nginx same-origin proxy instead.
VITE_API_BASE_URL=https://api.tp.dstw.dev
APP_BASE_URL=https://tp.dstw.dev
