diff --git a/lib/service/govclear_knowledge.dart b/lib/service/govclear_knowledge.dart
new file mode 100644
--- /dev/null
+++ b/lib/service/govclear_knowledge.dart
@@ -0,0 +1,160 @@
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter/foundation.dart';
+
+/// The source bundle remains unchanged; this projection preserves every metadata field.
+class GovClearKnowledge {
+  static const checksum =
+      'a0f787503597e109b07ffb17544368b509b7c95fffed1e9c7d14268ac40d46a6';
+  static Future<List<Map<String, dynamic>>>? _loaded;
+
+  static Future<List<Map<String, dynamic>>> _load() async {
+    final bytes = await rootBundle.load('assets/govclear_rag/knowledge.json');
+    final data = bytes.buffer.asUint8List(
+      bytes.offsetInBytes,
+      bytes.lengthInBytes,
+    );
+    return compute(decode, data);
+  }
+
+  static List<Map<String, dynamic>> decode(Uint8List data) {
+    if (sha256.convert(data).toString() != checksum) {
+      throw StateError('知識庫版本驗證失敗，請重新安裝 App。');
+    }
+    final value = jsonDecode(utf8.decode(data)) as Map<String, dynamic>;
+    return (value['units'] as List).cast<Map<String, dynamic>>();
+  }
+
+  static List<Map<String, dynamic>> search(
+    List<Map<String, dynamic>> units,
+    List<String> terms,
+  ) {
+    final words = terms
+        .map((t) => t.trim().toLowerCase())
+        .where((t) => t.isNotEmpty)
+        .toSet();
+    final pairs = <String>{};
+    for (final word in words) {
+      for (final run in RegExp(r'[\u3400-\u9fff]+').allMatches(word)) {
+        final value = run[0]!;
+        for (var i = 0; i < value.length - 1; i++) {
+          pairs.add(value.substring(i, i + 2));
+        }
+      }
+    }
+    final scored = <({Map<String, dynamic> unit, int score})>[];
+    for (final unit in units) {
+      final text = unit['text'];
+      if (text is! String ||
+          text.trim().isEmpty ||
+          text.trim() == '（刪除）' ||
+          unit['abolished'] == true) {
+        continue;
+      }
+      final haystack = '${unit['title']} $text'.toLowerCase();
+      final score =
+          100 * words.where(haystack.contains).length +
+          pairs.where(haystack.contains).length;
+      if (score > 0) scored.add((unit: unit, score: score));
+    }
+    scored.sort((a, b) {
+      final order = b.score.compareTo(a.score);
+      return order != 0
+          ? order
+          : (a.unit['unit_id'] as String).compareTo(
+              b.unit['unit_id'] as String,
+            );
+    });
+    // shortcut: lexical recall only; add measured FTS ranking if this small corpus grows.
+    return scored.take(3).map((row) => row.unit).toList();
+  }
+
+  // Select whole legal paragraphs; the evidence text and source document stay intact.
+  static String contextText(String text, String source) {
+    final cues = <String>{};
+    for (final run in RegExp(r'[\u3400-\u9fff]+').allMatches(source)) {
+      final word = run[0]!;
+      for (var i = 0; i < word.length - 1; i++) {
+        cues.add(word.substring(i, i + 2));
+      }
+    }
+    final lines = text.trim().split(RegExp(r'\n+'));
+    if (cues.isEmpty || lines.length < 2) return text;
+    final mainItem = RegExp(r'^[一二三四五六七八九十百]+、');
+    final subItem = RegExp(r'^（[一二三四五六七八九十百]+）');
+    final mainItems = lines.skip(1).any(mainItem.hasMatch);
+    final subItems = lines.skip(1).any(subItem.hasMatch);
+    final blocks = <String>[lines.first];
+    for (final line in lines.skip(1)) {
+      if ((mainItems && subItem.hasMatch(line)) ||
+          (!mainItems && subItems && !subItem.hasMatch(line))) {
+        blocks[blocks.length - 1] += '\n$line';
+      } else {
+        blocks.add(line);
+      }
+    }
+    var best = -1, score = 0;
+    for (var i = 1; i < blocks.length; i++) {
+      final hits = cues.where(blocks[i].contains).length;
+      if (hits > score ||
+          (hits == score &&
+              hits > 0 &&
+              blocks[i].length < blocks[best].length)) {
+        best = i;
+        score = hits;
+      }
+    }
+    if (best < 0) return text;
+    final selected = <int>{0, best};
+    if (!mainItems && subItems) {
+      selected.add(1); // FAQ base answer qualifies later instructions.
+    }
+    final ordinal = mainItem
+        .firstMatch(blocks[best])
+        ?.group(0)
+        ?.replaceAll('、', '');
+    if (ordinal != null) {
+      for (var i = 1; i < blocks.length; i++) {
+        if (blocks[i].contains('第$ordinal款')) selected.add(i);
+      }
+    }
+    for (final match in RegExp(
+      r'前項第([一二三四五六七八九十]+)款',
+    ).allMatches(blocks[best])) {
+      for (var i = 1; i < blocks.length; i++) {
+        if (blocks[i].startsWith('${match[1]}、')) selected.add(i);
+      }
+    }
+    return (selected.toList()..sort()).map((i) => blocks[i]).join('\n');
+  }
+
+  static Future<String> retrieve(
+    String encodedTerms, {
+    String source = '',
+  }) async {
+    final input = jsonDecode(encodedTerms);
+    if (input is! List || input.any((x) => x is! String)) {
+      throw StateError('無效檢索條件。');
+    }
+    final units = await (_loaded ??= _load().catchError((Object e) {
+      _loaded = null;
+      throw e;
+    }));
+    return jsonEncode({
+      'datasetVersion': 'CityBridgeFlutterEngine_v0_1_0',
+      'datasetHash': checksum,
+      'retrievedAt': DateTime.now().toUtc().toIso8601String(),
+      'historicalApplicability': 'unverified',
+      'evidence': search(units, input.cast<String>()).map((unit) {
+        final context = contextText(unit['text'] as String, source);
+        return {
+          ...unit,
+          'context_text': context,
+          'context_is_excerpt': context != unit['text'],
+        };
+      }).toList(),
+    });
+  }
+}
